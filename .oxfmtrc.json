{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/dist", "**/node_modules", "**/release"],
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": false,
  "semi": true,
  "sortImports": {
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "functions": ["cn", "cva"],
    "stylesheet": "./client/src/styles.css"
  }
}
