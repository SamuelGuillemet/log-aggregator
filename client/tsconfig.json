{
  "extends": "../tsconfig.base.json",

  "compilerOptions": {
    "composite": true,

    "jsx": "react-jsx",

    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "types": ["vite/client"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "allowJs": false,

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "references": [
    {
      "path": "../shared"
    }
  ],

  "include": ["src"]
}
