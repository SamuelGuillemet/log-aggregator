    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@log-aggregator/shared": "workspace:*",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1"
  }
}
